# Configure these as SERVER SECRETS in the hosting settings; never commit real keys,
# never paste them in chat, browser code, backups or URLs.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional model overrides (verify each against your provider account first).
OPENAI_MODEL=gpt-6-astra
ANTHROPIC_MODEL=claude-sonnet-5-5
ANTHROPIC_EFFORT=medium
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_VIDEO_MODEL=sora-2

# Optional per-instance request limits per 10 minutes (best effort; also set a
# monthly spending limit in the OpenAI and Anthropic dashboards).
RATE_LIMIT_TEXT=30
RATE_LIMIT_IMAGE=12
RATE_LIMIT_TTS=30
RATE_LIMIT_VIDEO=4

# Cross-device sync needs host bindings, not secrets: D1 database as DB, R2 bucket as MEDIA.
# Optional cloud media quota per owner in bytes (default 5 GB).
SYNC_QUOTA_BYTES=5368709120
